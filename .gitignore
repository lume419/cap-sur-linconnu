node_modules/
.env
*.log
# Dumps GeoNames bruts téléchargés par scripts/build-country-communes.js / build-aliases.js — gros
# fichiers sources (jusqu'à ~70 Mo), jamais commités, seuls les fichiers publics/data/*.txt générés
# le sont. Voir le commentaire en tête de ces deux scripts.
scripts/dump/
# Moisson brute de Nominatim (scripts/fetch-osm-postcodes.js) : une ligne par lieu interrogé, réponse comprise.
# Intermédiaire régénérable, comme les autres collectes ci-dessus — mais le refaire coûte 1 h 50 d interrogation à
# une requête par seconde, alors GARDEZ-LE si vous l avez. Les TABLES qui en sortent (scripts/postal-osm/XX.txt),
# elles, sont commitées : le générateur et tests/corrections.test.js les lisent.
scripts/postal-osm/cache.jsonl
scripts/postal/
scripts/altnames/
# Idem pour les extractions ponctuelles de sources tierces (codes postaux Bosnie/Monténégro/Kosovo,
# absents de GeoNames — voir build-ba/me/xk-communes.js) : intermédiaires régénérables en refaisant
# la collecte documentée dans ces scripts, jamais commités, comme ba-postal-wiki.json avant eux.
scripts/me-postal-raw.json
scripts/me-canonical-by-geonameid.json
scripts/xk-postal-raw.json
scripts/xk-canonical-by-geonameid.json
scripts/ba-postal-wiki.json
scripts/ba-canonical-by-geonameid.json
scripts/gr-postal-raw.csv
scripts/gr-canonical-by-geonameid.json
scripts/ge-postal-raw.json
scripts/ge-canonical-by-geonameid.json
# Lot Maghreb : codes postaux tunisiens (jeu tiers sans licence, voir build-maghreb-communes.js) et
# table GeoNames des noms de divisions administratives, utilisée pour contrôler la wilaya des points
# postaux algériens. Sources brutes régénérables en refaisant la collecte documentée dans le script.
scripts/tn-postal-raw.json
scripts/admin1CodesASCII.txt
# Bundles texte produits par scripts/build-data-bundles.js (lus par server.js pour initialiser le moteur) et leur
# fichier temporaire d'écriture : régénérés à chaque déploiement (postinstall dans package.json), jamais commités.
# Les .gz/.br ne sont plus produits (effacés par le script) ; motifs gardés pour les copies de travail anciennes.
# Index de recherche de ville précalculé (scripts/build-search-index.js, voir lib/search-index.js), son dossier
# temporaire et son verrou : ~900 Mo, régénéré à chaque déploiement par npm install ou par le serveur, jamais commité.
cache/
public/data/communes-bundle.txt
public/data/aliases-bundle.txt
public/data/*-bundle.txt.tmp
public/data/*-bundle.txt.gz
public/data/*-bundle.txt.br
# Configuration locale de l'outillage de développement (lancement du serveur de prévisualisation par
# `node server.js` sur le port 3000) : dépend de la machine, ne décrit rien que `npm start` ne dise
# déjà, jamais commitée. Seul ce fichier est exclu, pas tout `.claude/` — un éventuel réglage de
# projet ajouté plus tard doit rester versionnable sans avoir à défaire cette ligne.
.claude/launch.json

# Extractions Open Charge Map intermédiaires (bornes de recharge par pays, scripts/fetch-charging-stations.js) — seul data/charging-stations.txt est commité
scripts/osm/
