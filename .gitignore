node_modules/
.env
*.log
# Dumps GeoNames bruts téléchargés par scripts/build-country-communes.js / build-aliases.js — gros
# fichiers sources (jusqu'à ~70 Mo), jamais commités, seuls les fichiers publics/data/*.txt générés
# le sont. Voir le commentaire en tête de ces deux scripts.
scripts/dump/
scripts/postal/
scripts/altnames/
# Idem pour les extractions ponctuelles de sources tierces (codes postaux Bosnie/Monténégro/Kosovo,
# absents de GeoNames — voir build-ba/me/xk-communes.js) : intermédiaires régénérables en refaisant
# la collecte documentée dans ces scripts, jamais commités, comme ba-postal-wiki.json avant eux.
scripts/me-postal-raw.json
scripts/me-canonical-by-geonameid.json
scripts/xk-postal-raw.json
scripts/xk-canonical-by-geonameid.json
scripts/ba-postal-wiki.json
scripts/ba-canonical-by-geonameid.json
scripts/gr-postal-raw.csv
scripts/gr-canonical-by-geonameid.json
# Bundles précompilés (texte + gzip + brotli) produits par scripts/build-data-bundles.js — voir
# son commentaire d'en-tête et server.js ("Bundles /data/") : régénérés automatiquement à chaque
# déploiement (postinstall dans package.json), jamais commités, comme les dumps GeoNames ci-dessus.
public/data/communes-bundle.txt
public/data/communes-bundle.txt.gz
public/data/communes-bundle.txt.br
public/data/aliases-bundle.txt
public/data/aliases-bundle.txt.gz
public/data/aliases-bundle.txt.br
